{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "pages/index.tsx": {
      "maxDuration": 60
    },
    "pages/[pageId].tsx": {
      "maxDuration": 60
    },
    "pages/feed.tsx": {
      "maxDuration": 60
    },
    "pages/sitemap.xml.tsx": {
      "maxDuration": 60
    },
    "pages/api/*.ts": {
      "maxDuration": 30
    },
    "pages/api/*.tsx": {
      "maxDuration": 60
    },
    "pages/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
